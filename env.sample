# Veo 3 Production Service Environment Configuration

# =========================
# CORE SERVICE
# =========================
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://myapp.com

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://user:password@localhost:5432/veo3_production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# =========================
# REDIS & QUEUE
# =========================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =========================
# AI SERVICES
# =========================
GEMINI_API_KEY=your_gemini_api_key
VEO_MODEL_ID=veo-3.0-generate-001

# =========================
# STRIPE BILLING
# =========================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_RENDER=price_xxx_per_render
STRIPE_PRICE_SUB_PRO=price_xxx_monthly_pro
STRIPE_PRICE_SUB_ENTERPRISE=price_xxx_monthly_enterprise

# =========================
# RATE LIMITS & QUOTAS
# =========================
RENDERS_PER_DAY_FREE=5
RENDERS_PER_DAY_PRO=100
RENDERS_PER_DAY_ENTERPRISE=1000
RENDERS_CONCURRENCY=2
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# =========================
# STORAGE & CDN
# =========================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=veo3-production-assets
AWS_CLOUDFRONT_DOMAIN=cdn.myapp.com
ASSET_LIFECYCLE_DAYS=90

# =========================
# WEBHOOKS & NOTIFICATIONS
# =========================
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=5000
WEBHOOK_TIMEOUT_MS=30000

# =========================
# OBSERVABILITY
# =========================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn
DATADOG_API_KEY=your_datadog_key
NEW_RELIC_LICENSE_KEY=your_newrelic_key

# =========================
# SECURITY
# =========================
JWT_SECRET=your_jwt_secret_key_here
API_KEY_SECRET=your_api_key_secret
ENCRYPTION_KEY=your_encryption_key_32_chars
CORS_ORIGINS=https://myapp.com,https://admin.myapp.com

# =========================
# CROSS-PLATFORM PUBLISHING
# =========================
OAUTH_ENCRYPTION_KEY=your_32_byte_oauth_encryption_key
TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
YT_CLIENT_ID=your_youtube_client_id
YT_CLIENT_SECRET=your_youtube_client_secret

# =========================
# MEDIA PROCESSING
# =========================
FFMPEG_PATH=/usr/bin/ffmpeg
MAX_UPLOAD_MB=12

# =========================
# CONTENT MODERATION
# =========================
MODERATION_ENABLED=true
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project
GOOGLE_CLOUD_CREDENTIALS_PATH=path/to/service-account.json

# =========================
# LOCALIZATION
# =========================
LOCA_SUPPORTED=en,es,fr,de,it,pt
DEFAULT_LOCALE=en

# =========================
# PRICING
# =========================
COST_PER_RENDER_CENTS=25

# =========================
# RAG & EMBEDDINGS
# =========================
OPENAI_API_KEY=your_openai_api_key
RAG_MAX_CHUNKS=6
RAG_CHUNK_SIZE=1200

# =========================
# FEATURE FLAGS
# =========================
FLAG_DEFAULTS={"composer_rag": true, "composer_cache": true, "breaker_veo": true}

# =========================
# JOB MANAGEMENT
# =========================
CANCEL_GRACE_MS=8000

# =========================
# COMMERCE & ATTRIBUTION
# =========================
PUBLIC_BASE_URL=https://localhost:5173
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_product_listings,read_files,write_files,read_price_rules
SHOPIFY_REDIRECT_URI=${PUBLIC_BASE_URL}/api/commerce/shopify/callback
LINK_DOMAIN=${PUBLIC_BASE_URL}
UTM_SOURCE_DEFAULT=veo3
PIXEL_VERIFY_SECRET=change-me

# =========================
# PRODUCTION DELIVERY & SCALE
# =========================
CDN_BASE_URL=https://cdn.yourdomain.com
HLS_VARIANTS=426x240,640x360,854x480
HLS_SEGMENT_SEC=2
SIGNING_SECRET=your_jwt_signing_secret_here
MODEL_PRIMARY=veo-3.0-generate-001
MODEL_FAST=veo-3.0-fast-generate-001
MODEL_MAX_LATENCY_MS=45000
QUALITY_MIN_SCORE=0.62
JOB_TTL_DAYS=90
GDPR_EXPORT_TTL_MIN=30
MONITOR_PING_URL=https://api.uptimerobot.com/v2/getMonitors

# =========================
# FEATURE FLAGS
# =========================
ENABLE_PUBLIC_API=true
ENABLE_WEBHOOKS=true
ENABLE_BILLING=true
ENABLE_ORGS=true
ENABLE_CDN=true
ENABLE_ANALYTICS=true
ENABLE_PUBLISHING=true
ENABLE_MODERATION=true
ENABLE_LOCALIZATION=true
ENABLE_AB_TESTING=true

# =========================
# DEVELOPMENT
# =========================
# Uncomment for local development
# NODE_ENV=development
# PUBLIC_BASE_URL=http://localhost:3000
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://postgres:password@localhost:5432/veo3_dev
