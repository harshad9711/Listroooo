{
  "name": "veo3-production-api",
  "version": "1.0.0",
  "description": "Veo 3 Cinematic Generator Production API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "worker": "node workers/index.js",
    "worker:dev": "cross-env NODE_ENV=development nodemon workers/index.js",
    "queue:clean": "node scripts/clean-queue.js",
    "billing:sync": "node scripts/sync-billing.js",
    "cdn:cleanup": "node scripts/cdn-cleanup.js",
    "health": "node scripts/health-check.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.39.0",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.4",
    "pino": "^8.17.2",
    "pino-http": "^8.5.0",
    "stripe": "^14.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "aws-sdk": "^2.1509.0",
    "node-cron": "^3.0.3",
    "axios": "^1.6.2",
    "crypto": "^1.0.1",
    "fs-extra": "^11.2.0",
    "sharp": "^0.33.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "vitest": "^1.1.0",
    "supertest": "^6.3.3",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "veo3",
    "ai",
    "video",
    "generation",
    "production",
    "api",
    "stripe",
    "redis",
    "queue"
  ],
  "author": "Veo 3 Team",
  "license": "MIT"
}

