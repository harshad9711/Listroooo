{
  "name": "veo3-production-api",
  "version": "1.0.0",
  "description": "Veo 3 Cinematic Generator Production API",
  "main": "server-production.js",
  "type": "module",
  "scripts": {
    "start": "node server-production.js",
    "dev": "cross-env NODE_ENV=development nodemon server-production.js",
    "worker": "node scripts/worker.js",
    "worker:dev": "cross-env NODE_ENV=development nodemon scripts/worker.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "billing:daily": "node scripts/daily-billing.js",
    "cleanup:cdn": "node scripts/cdn-cleanup.js",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "build": "tsc",
    "health": "node scripts/health-check.js",
    "example:queue": "node examples/queue-usage.js"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.0.2",
    "@google/generative-ai": "^0.21.0",
    "@shopify/shopify-api": "^8.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "aws-sdk": "^2.1509.0",
    "axios": "^1.6.2",
    "bad-words": "^3.0.4",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "i18next": "^23.7.6",
    "i18next-fs-backend": "^2.3.1",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.1.0",
    "nanoid": "^5.0.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.20.1",
    "opossum": "^8.0.1",
    "p-queue": "^8.1.1",
    "pgvector": "^0.1.8",
    "pino": "^8.17.2",
    "pino-http": "^8.5.0",
    "sharp": "^0.33.0",
    "stripe": "^14.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "k6": "^0.0.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.40.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "veo3",
    "ai",
    "video",
    "generation",
    "production",
    "api",
    "stripe",
    "redis",
    "queue"
  ],
  "author": "Veo 3 Team",
  "license": "MIT"
}
